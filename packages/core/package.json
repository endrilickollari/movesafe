{
  "name": "@movesafe/core",
  "version": "0.2.0",
  "description": "TypeScript import-graph, move-planning, and validation engine for movesafe.",
  "license": "MIT",
  "author": "Endri Liçkollari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endrilickollari/movesafe.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/endrilickollari/movesafe#readme",
  "bugs": {
    "url": "https://github.com/endrilickollari/movesafe/issues"
  },
  "keywords": [
    "typescript",
    "refactoring",
    "imports"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "vitest": "^5.0.5"
  }
}
